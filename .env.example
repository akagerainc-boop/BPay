# Copy to .env and adjust for your XAMPP setup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bpay

# Change this before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=12

# First-run admin account, created by seed.py if no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

HOST=0.0.0.0
PORT=5000

# Sending push notifications (Announcements tab). Get this from Firebase
# Console > Project settings (gear icon) > Service accounts >
# "Generate new private key" — downloads a JSON file. Save it in this
# backend/ folder and point this at it. Until this file exists,
# Announcements can still be created but the push itself is skipped with a
# clear error instead of crashing the server.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Where the app should reach uploaded photos/logos — the same LAN address
# used for API_BASE_URL on the Flutter side. Defaults to building the URL
# from the incoming request's own host, which works for most setups.
# PUBLIC_BASE_URL=http://192.168.1.10:5000
